<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= coins.name %> — CryptoView</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <nav>
        <a href="/" class="nav-brand">Crypto<span>View</span></a>
        <form class="nav-search" action="/search" method="GET">
            <input name="coin" type="text" placeholder="Search for a coin…">
            <button type="submit">Search</button>
        </form>
    </nav>

    <div class="coin-detail-page">
        <div style="max-width: 680px; width: 100%;">
            <a href="/" class="back-link">← Back to markets</a>
            <div class="coin-card">
                <div class="coin-card-header">
                    <span class="coin-card-name"><%= coins.name %></span>
                    <span class="coin-card-symbol"><%= coins.symbol.toUpperCase() %></span>
                </div>
                <div class="coin-stats-grid">
                    <div class="coin-stat">
                        <div class="coin-stat-label">Current Price</div>
                        <div class="coin-stat-value">$<%= coins.market_data.current_price.usd.toLocaleString() %></div>
                    </div>
                    <div class="coin-stat">
                        <div class="coin-stat-label">24h Change</div>
                        <div class="coin-stat-value <%= coins.market_data.price_change_percentage_24h >= 0 ? 'gain' : 'loss' %>">
                            <%= coins.market_data.price_change_percentage_24h >= 0 ? '▲' : '▼' %>
                            <%= Math.abs(coins.market_data.price_change_percentage_24h).toFixed(2) %>%
                        </div>
                    </div>
                    <div class="coin-stat">
                        <div class="coin-stat-label">Market Cap</div>
                        <div class="coin-stat-value">$<%= (coins.market_data.market_cap.usd / 1e9).toFixed(2) %>B</div>
                    </div>
                    <div class="coin-stat">
                        <div class="coin-stat-label">Market Cap Rank</div>
                        <div class="coin-stat-value">#<%= coins.market_cap_rank %></div>
                    </div>
                </div>
                <div class="coin-description">
                    <div class="coin-description-label">About</div>
                    <p>
                        <% if (coins.description.en) { %>
                            <%= coins.description.en %>
                        <% } else { %>
                            No description available.
                        <% } %>
                    </p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>